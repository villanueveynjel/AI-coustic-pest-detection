{
  "name": "ai-coustic-rice-field-monitoring",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "vite build",
    "firebase:emulators": "firebase emulators:start --only auth,firestore",
    "firebase:deploy:rules": "firebase deploy --only firestore:rules,firestore:indexes",
    "android:add": "cap add android",
    "android:sync": "npm run build && cap sync android",
    "android:open": "cap open android",
    "apk:debug": "npm run build && cap sync android && cd android && gradlew.bat assembleDebug"
  },
  "dependencies": {
    "@capacitor-firebase/authentication": "^7.5.0",
    "@capacitor/android": "^7.4.3",
    "@capacitor/core": "^7.4.3",
    "@capacitor/local-notifications": "^7.0.7",
    "@capacitor/push-notifications": "^7.0.7",
    "firebase": "^12.19.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^7.4.3",
    "firebase-tools": "^14.12.0",
    "vite": "^7.1.0"
  }
}
