rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function owns(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    match /users/{uid} {
      allow read, create, update: if owns(uid);
      allow delete: if false;

      match /detections/{detectionId} {
        allow read: if owns(uid);
        allow create: if owns(uid)
          && request.resource.data.pest is string
          && request.resource.data.detectedAt is timestamp;
        allow update, delete: if false;
      }

      match /monitoringLogs/{logId} {
        allow read: if owns(uid);
        allow create: if owns(uid)
          && request.resource.data.type is string
          && request.resource.data.createdAt is timestamp;
        allow update, delete: if false;
      }

      match /operations/{operationId} {
        allow read: if owns(uid);
        allow create, update: if owns(uid);
        allow delete: if false;
      }

      match /notifications/{notificationId} {
        allow read: if owns(uid);
        allow create: if owns(uid);
        allow update: if owns(uid)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read', 'readAt']);
        allow delete: if owns(uid);
      }
    }
  }
}
